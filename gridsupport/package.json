{
  "name": "gridsupport-stage-one",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:integration && npm run test:default-mint && npm run test:idl",
    "test:idl": "node --import tsx --test tests/architecture.spec.ts",
    "test:default-mint": "node --import tsx ./node_modules/mocha/bin/mocha.js --timeout 30000 tests/default-mint.spec.ts",
    "test:integration": "bash scripts/test-integration.sh",
    "test:integration:run": "node --import tsx ./node_modules/mocha/bin/mocha.js --timeout 30000 'tests/integration/**/*.spec.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@solana/spl-token": "0.4.14",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.3",
    "litesvm": "0.8.0",
    "mocha": "11.7.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0"
  }
}
